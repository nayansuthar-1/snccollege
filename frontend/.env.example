# Server-only. Base URL of the WordPress install (no trailing slash).
WORDPRESS_URL=http://localhost:8881
# Public URL of this Next.js site (used for metadata, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret with WordPress (SNC_REVALIDATE_SECRET in wp-config.php).
REVALIDATE_SECRET=
